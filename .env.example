# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=18080

# Database (SQLite)
DATABASE_URL=sqlite:storage/reader.db?mode=rwc

# Storage paths
STORAGE_DIR=storage
ASSETS_DIR=storage/assets

# File cache governance (default: 1 GiB, 30 days)
CACHE_MAX_BYTES=1073741824
CACHE_MAX_AGE_DAYS=30

# Web frontend path (adjust if needed)
WEB_ROOT=frontend/dist

# Logging
LOG_LEVEL=info

# Request timeout in seconds
REQUEST_TIMEOUT_SECS=15

# Security settings
SECURE=true
SECURE_KEY=

# User registration
INVITE_CODE=
USER_LIMIT=50
USER_BOOK_LIMIT=2000
